# ICU resolves the symbol `U_ICUDATA_ENTRY_POINT` at link time and treats what
# it finds as the common data package. This builds ICU's empty stub package
# into that symbol. The real package is registered at runtime by
# `SetICUCommonData` in jsglue.cpp, from the bytes in mozjs-sys/icu-data.
# Registered data is searched before the stub, so the stub never satisfies a
# lookup.
#
# The registered package is little-endian. A big-endian target would need a
# byte-swapped blob, which the generator does not produce.
Library("icudata")

include("../defs.mozbuild")

LOCAL_INCLUDES += ["/intl/icu/source/stubdata"]

SOURCES += [
    "/intl/icu/source/stubdata/stubdata.cpp",
]
